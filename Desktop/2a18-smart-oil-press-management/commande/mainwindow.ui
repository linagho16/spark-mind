  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
  font-family: &quot;Segoe UI&quot;;
  font-size: 14px;
  background: #F4EEE4;
  color: #1F2937;
}
#topBar {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #243C53, stop:1 #2B5978);
  border-radius: 10px;
}
QFrame#sidebar {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #2A3B4C, stop:1 #1E2B39);
  border-right: 1px solid #16202C;
}
QLabel#sidebarTitle {
  color: #F5F5F5;
  font-weight: 700;
  font-size: 13px;
  margin-bottom: 10px;
}
QPushButton#navActive,
QPushButton#navButton_2,
QPushButton#navButton_3,
QPushButton#navButton_4,
QPushButton#navAccent {
  text-align: left;
  padding: 12px 16px;
  border-radius: 10px;
  font-weight: 600;
}
QPushButton[navState="normal"] {
  background-color: #314A67;
  color: #FFFFFF;
  border: 2px solid #24364D;
}
QPushButton[navState="active"] {
  background-color: #F2B705;
  color: #1F2937;
  border: 2px solid #C99305;
  font-weight: 700;
}
#titleLabel {
  color: #FBC02D;
  font-size: 22px;
  font-weight: 700;
}
#subTitleLabel {
  color: #E8ECF4;
  font-size: 12px;
}
#filterBar, #tableActionBar {
  background: #FFFFFF;
  border-radius: 10px;
  border: 1px solid #E3D8C7;
}
#detailsGroup {
  background: #FFFFFF;
  border-radius: 10px;
  border: 1px solid #E3D8C7;
  margin-top: 6px;
}
QLineEdit, QComboBox {
  background: #FFFBF5;
  border: 1px solid #D7C9B6;
  border-radius: 6px;
  padding: 6px 10px;
}
QLineEdit:focus, QComboBox:focus {
  border: 1px solid #2B5978;
}
QPushButton {
  border: none;
  border-radius: 6px;
  padding: 8px 14px;
  font-weight: 600;
  background: #6B8E23;
  color: white;
}
QPushButton#filterButton, QPushButton#exportButton {
  background: #F2B705;
  color: #2B2B2B;
}
QPushButton#resetFilterButton, QPushButton#clearButton {
  background: #9E9E9E;
  color: white;
}
QPushButton#deleteButton {
  background: #C62828;
  color: white;
}
QTableWidget {
  background: #FFFFFF;
  border: 1px solid #E3D8C7;
  border-radius: 10px;
  gridline-color: #E3D8C7;
  selection-background-color: #FFE9B5;
  selection-color: #1F2937;
}
QHeaderView::section {
  background: #2B5978;
  color: white;
  padding: 8px;
  border: none;
  font-weight: 600;
}</string>

  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">/* STYLE GLOBAL - THEME NATURE &amp; HUILE */
QWidget#centralwidget {
    background-color: #F4EEE4;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
}

/* --- BARRE DU HAUT --- */
QFrame#topBar,
QFrame#topBarCommande,
QFrame#topBarStock,
QFrame#topBarAgriculteur {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #243C53, stop:1 #2B5978);
    border-radius: 10px;
}
QLabel#appTitle,
QLabel#commandeTitle,
QLabel#stockTitle,
QLabel#agriculteurTitle {
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 700;
    padding: 0 6px;
}
QLabel#userLabel,
QLabel#commandeUserLabel,
QLabel#stockUserLabel,
QLabel#agriculteurUserLabel { color: #E6EEF4; font-size: 12px; }

/* --- SIDEBAR (Style type capture) --- */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2A3B4C, stop:1 #1E2B39);
    border-right: 1px solid #16202C;
}
QLabel#sidebarTitle {
    color: #F5F5F5;
    font-weight: 700;
    font-size: 13px;
    margin: 8px 0 10px 0;
}

QPushButton#navActive,
QPushButton#navButton_2,
QPushButton#navButton_3,
QPushButton#navButton_4,
QPushButton#navAccent {
    text-align: left;
    padding: 12px 16px;
    border-radius: 10px;
    font-weight: 600;
}

QPushButton[navState=&quot;normal&quot;] {
    background-color: #314A67;
    color: #FFFFFF;
    border: 2px solid #24364D;
}

QPushButton[navState=&quot;active&quot;] {
    background-color: #F2B705;
    color: #1F2937;
    border: 2px solid #C99305;
    font-weight: 700;
}

/* --- CARTE CENTRALE --- */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E3D8C7;
    border-radius: 12px;
}
QLabel#cardTitle { color: #245B7A; font-weight: 700; font-size: 16px; }

/* --- TABLEAU (En Vert maintenant) --- */
QTableWidget {
    background-color: #ffffff; gridline-color: #E3D8C7; selection-background-color: #FFE9B5; selection-color: #000000; border: 1px solid #E3D8C7;
}
QHeaderView::section {
    background-color: #2B5978; color: #FFFFFF; padding: 8px; border: none; font-weight: 600;
}

/* --- FORMULAIRE --- */
/* Bordures vertes au lieu de bleues */
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: #FFFBF5; border: 2px solid #2B5978; border-radius: 6px; padding: 6px; color: #333;
}

/* Bouton Valider */
QPushButton#btn_valider_ext {
    background-color: #6B8E23; color: white; padding: 10px; border-radius: 6px; font-weight: bold; font-size: 13px;
}
QPushButton#btn_valider_ext:hover { background-color: #5A7A1E; }

QPushButton#btn_modifier_ext {
    background-color: #6B8E23;
    color: #FFFFFF;
    padding: 10px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_modifier_ext:hover { background-color: #5A7A1E; }
QPushButton#btn_supprimer_ext {
    background-color: #C62828;
    color: #FFFFFF;
    padding: 10px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btn_supprimer_ext:hover { background-color: #B71C1C; }

QPushButton#btnSortExt,
QPushButton#btnSearchExt,
QPushButton#btnStatsExt {
    background-color: #6B8E23;
    color: #FFFFFF;
    padding: 8px 12px;
    border-radius: 6px;
    font-weight: 600;
}
QPushButton#btnExportPdfExt {
    background-color: #F2B705;
    color: #2B2B2B;
    padding: 8px 12px;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton#btnSortExt:hover,
QPushButton#btnSearchExt:hover,
QPushButton#btnStatsExt:hover {
    background-color: #5A7A1E;
}
QPushButton#btnExportPdfExt:hover { background-color: #E0A800; }

QPushButton:hover {
    background-color: #F2B705;
    color: #FFFFFF;
}
</string>

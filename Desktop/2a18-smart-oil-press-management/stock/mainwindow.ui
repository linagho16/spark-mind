  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">/* Palette */
QWidget#centralwidget {
    background-color: #F4EEE4;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
}

QFrame#topBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2A3B4C, stop:1 #1E2B39);
    border-radius: 10px;
}

QLabel#appTitle {
    color: #F5F5F5;
    font-size: 17px;
    font-weight: 700;
}

QLabel#topIcons {
    color: #FBC02D;
    font-size: 14px;
}

QLabel#userLabel {
    color: #F5F5F5;
    font-size: 12px;
}

QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2A3B4C, stop:1 #1E2B39);
    border-right: 1px solid #16202C;
}

QLabel#sidebarTitle {
    color: #F5F5F5;
    font-weight: 700;
    font-size: 13px;
}

QPushButton[nav=&quot;true&quot;] {
    background-color: #314A67;
    border: 1px solid #24364d;
    color: #FFFFFF;
    text-align: left;
    padding: 12px 16px;
    border-radius: 8px;
}

QPushButton[nav=&quot;true&quot;]:hover {
    background-color: #F2B705;
    border: 1px solid #C99350;
    color: #1F2937;
}

QPushButton[nav=&quot;true&quot;][active=&quot;true&quot;] {
    background-color: #F2B705;
    border: 1px solid #C99350;
    color: #1F2937;
}

QPushButton[nav=&quot;true&quot;][active=&quot;true&quot;]:hover {
    background-color: #F2B705;
    border: 1px solid #C99350;
    color: #1F2937;
}

QLabel#sectionTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
}

QPushButton {
    background-color: #6B8E23;
    color: #F5F5F5;
    border: none;
    padding: 9px 16px;
    border-radius: 10px;
}

QPushButton:hover {
    background-color: #5A7A1E;
    color: #F5F5F5;
}

QPushButton#btnSecondary {
    background-color: #F2B705;
    color: #2B5978;
}

QPushButton#btnSecondary:hover {
    background-color: #E0A800;
    color: #2B5978;
}

QPushButton#btnDelete {
    background-color: #C62828;
    color: #FFFFFF;
}

QPushButton#btnDelete:hover {
    background-color: #B71C1C;
    color: #FFFFFF;
}

QLineEdit {
    background-color: #FFFBF5;
    border: 1px solid #E3D8C7;
    border-radius: 10px;
    padding: 8px 10px;
    min-height: 30px;
}

QFrame#cardAlert,
QFrame#cardTopUp,
QFrame#cardLocations,
QFrame#cardInventory,
QFrame#cardChart,
QFrame#cardActions {
    background-color: #FFFFFF;
    border: 1px solid #E3D8C7;
    border-radius: 12px;
}

QLabel#cardTitleAlert,
QLabel#cardTitleTopUp,
QLabel#cardTitleLocations,
QLabel#cardTitleInventory,
QLabel#cardTitleChart,
QLabel#cardTitleActions {
    color: #2B5978;
    font-weight: 700;
}

QTableWidget {
    background-color: #ffffff;
    gridline-color: #E3D8C7;
    selection-background-color: #FFE9B5;
    selection-color: #2B5978;
    border: none;
}

QHeaderView::section {
    background-color: #2B5978;
    color: #F5F5F5;
    padding: 8px 10px;
    border: none;
    font-weight: 600;
}

QTableWidget::item {
    padding: 6px 8px;
}

QLabel#alertLow {
    background-color: #D32F2F;
    color: #FFFFFF;
    padding: 4px 10px;
    border-radius: 8px;
}

QLabel#alertMid {
    background-color: #F57C00;
    color: #FFFFFF;
    padding: 4px 10px;
    border-radius: 8px;
}

QLabel#alertOk {
    background-color: #2E7D32;
    color: #FFFFFF;
    padding: 4px 10px;
    border-radius: 8px;
}</string>

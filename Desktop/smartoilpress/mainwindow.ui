           <!-- ── Right Column: Form Panel ── -->
           <item>
            <widget class="QFrame" name="rightCard">
             <property name="minimumWidth"><number>270</number></property>
             <property name="maximumWidth"><number>290</number></property>
             <layout class="QVBoxLayout" name="formPanelLayout">
              <property name="spacing"><number>8</number></property>
              <property name="leftMargin"><number>18</number></property>
              <property name="topMargin"><number>18</number></property>
              <property name="rightMargin"><number>18</number></property>
              <property name="bottomMargin"><number>18</number></property>

              <item>
               <widget class="QLabel" name="cardTitle">
                <property name="text"><string>Formulaire Agriculteur</string></property>
               </widget>
              </item>

              <!-- Separator -->
              <item>
               <widget class="QFrame" name="formSep">
                <property name="styleSheet">
                 <string notr="true">background-color: #E2EAF3; min-height: 1px; max-height: 1px;</string>
                </property>
               </widget>
              </item>

              <!-- ID -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>ID (auto)</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="idEdit">
                <property name="readOnly"><bool>true</bool></property>
                <property name="placeholderText"><string>Auto-généré</string></property>
               </widget>
              </item>

              <!-- CIN -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>CIN *</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="cinEdit">
                <property name="placeholderText"><string>Ex: AB123456</string></property>
               </widget>
              </item>

              <!-- Nom -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>Nom complet *</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="nomEdit">
                <property name="placeholderText"><string>Nom et prénom</string></property>
               </widget>
              </item>

              <!-- Adresse -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>Adresse</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="adresseEdit">
                <property name="placeholderText"><string>Ville, Région</string></property>
               </widget>
              </item>

              <!-- Téléphone -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>Téléphone</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="telephoneEdit">
                <property name="placeholderText"><string>+216 98 000 000</string></property>
               </widget>
              </item>

              <!-- Email -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>Email</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="emailEdit">
                <property name="placeholderText"><string>email@exemple.com</string></property>
               </widget>
              </item>

              <!-- Superficie -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>Superficie (ha)</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="superficieEdit">
                <property name="placeholderText"><string>0</string></property>
               </widget>
              </item>

              <!-- Oliviers -->
              <item>
               <widget class="QLabel">
                <property name="text"><string>Nombre d'oliviers</string></property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="oliviersEdit">
                <property name="placeholderText"><string>0</string></property>
               </widget>
              </item>

              <!-- Action Buttons -->
              <item>
               <layout class="QGridLayout" name="formBtnGrid">
                <property name="spacing"><number>8</number></property>
                <item row="0" column="0">
                 <widget class="QPushButton" name="ajouterBtn">
                  <property name="text"><string>Ajouter</string></property>
                 </widget>
                </item>
                <item row="0" column="1">
                 <widget class="QPushButton" name="modifierBtn">
                  <property name="text"><string>Modifier</string></property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QPushButton" name="effacerBtn">
                  <property name="text"><string>Effacer</string></property>
                 </widget>
                </item>
                <item row="1" column="1">
                 <widget class="QPushButton" name="supprimerBtn">
                  <property name="text"><string>Supprimer</string></property>
                 </widget>
                </item>
               </layout>
              </item>

              <!-- Attachment separator -->
              <item>
               <widget class="QFrame" name="attachSep">
                <property name="styleSheet">
                 <string notr="true">background-color: #D6E8C4; min-height: 1px; max-height: 1px;</string>
                </property>
               </widget>
              </item>

              <!-- Attachment label -->
              <item>
               <widget class="QLabel" name="attachLabel">
                <property name="text"><string>&#x1F4CE; Pi&#232;ce jointe</string></property>
                <property name="styleSheet">
                 <string notr="true">color: #4A6A32; font-size: 11px; font-weight: bold; padding-top: 4px;</string>
                </property>
               </widget>
              </item>

              <!-- Attachment buttons row -->
              <item>
               <layout class="QHBoxLayout" name="attachBtnRow">
                <property name="spacing"><number>8</number></property>
                <item>
                 <widget class="QPushButton" name="pieceJointeBtn">
                  <property name="text"><string>&#x1F4CE; Joindre fichier</string></property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="ouvrirFichierBtn">
                  <property name="text"><string>&#x1F441; Ouvrir</string></property>
                  <property name="enabled"><bool>false</bool></property>
                 </widget>
                </item>
               </layout>
              </item>

              <item>
               <spacer>
                <property name="orientation"><enum>Qt::Vertical</enum></property>
               </spacer>
              </item>

             </layout>
            </widget>
           </item>
           <!-- ── End Right Column ── -->

          </layout>
         </widget>
        </widget>
       </item>
       <!-- End Content Area -->

      </layout>
     </widget>
    </item>
    <!-- ════════ END MAIN AREA ════════ -->

   </layout>
  </widget>

  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <resources/>
 <connections/>
</ui>

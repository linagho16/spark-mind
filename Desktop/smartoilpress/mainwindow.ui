  <property name="windowTitle">
   <string>Smart Oil Press - Gestion des Agriculteurs</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QMainWindow { background-color: #F2F6EE; }
    QWidget#centralwidget { background-color: #F2F6EE; }

    /* ── Sidebar ── */
    QWidget#sidebar {
      background-color: #2D5016;
      min-width: 225px;
      max-width: 225px;
    }
    QLabel#logoTitle {
      color: #FFFFFF;
      font-size: 16px;
      font-weight: bold;
    }
    QLabel#logoSub {
      color: rgba(255,255,255,0.6);
      font-size: 11px;
    }
    QLabel#sectionLabel {
      color: rgba(255,255,255,0.42);
      font-size: 10px;
      letter-spacing: 1px;
    }
    QPushButton#agriBtn {
      background-color: rgba(255,255,255,0.13);
      color: #FFFFFF;
      border: none;
      border-left: 3px solid #8BC34A;
      text-align: left;
      padding: 9px 18px;
      font-size: 13px;
    }
    QPushButton#statsBtn, QPushButton#settingsBtn {
      background-color: transparent;
      color: rgba(255,255,255,0.72);
      border: none;
      border-left: 3px solid transparent;
      text-align: left;
      padding: 9px 18px;
      font-size: 13px;
    }
    QPushButton#statsBtn:hover, QPushButton#settingsBtn:hover {
      background-color: rgba(255,255,255,0.08);
      color: #FFFFFF;
    }
    QPushButton#logoutBtn {
      background-color: transparent;
      color: rgba(255,200,180,0.75);
      border: none;
      border-left: 3px solid transparent;
      text-align: left;
      padding: 9px 18px;
      font-size: 13px;
    }
    QPushButton#logoutBtn:hover {
      background-color: rgba(160,40,40,0.28);
      color: #FFAAAA;
    }
    QLabel#adminName {
      color: #FFFFFF;
      font-size: 13px;
      font-weight: bold;
    }
    QLabel#adminRole {
      color: rgba(255,255,255,0.52);
      font-size: 11px;
    }

    /* ── Top bar ── */
    QWidget#topbar {
      background-color: #FFFFFF;
      border-bottom: 1px solid #D6E8C4;
      min-height: 56px;
      max-height: 56px;
    }
    QLabel#pageTitle {
      color: #2D5016;
      font-size: 18px;
      font-weight: bold;
    }
    QLineEdit#searchInput {
      background-color: #F2F6EE;
      border: 1px solid #C8DFB0;
      border-radius: 8px;
      padding: 6px 12px;
      font-size: 13px;
      color: #2D5016;
      min-width: 220px;
      max-width: 220px;
    }
    QLineEdit#searchInput:focus {
      border: 1px solid #4A7C1F;
    }
    QPushButton#btnOutline {
      background-color: #FFFFFF;
      color: #4A7C1F;
      border: 1px solid #B8D89A;
      border-radius: 8px;
      padding: 7px 14px;
      font-size: 13px;
    }
    QPushButton#btnOutline:hover { background-color: #EEF7E4; }
    QPushButton#btnAdd {
      background-color: #4A7C1F;
      color: #FFFFFF;
      border: none;
      border-radius: 8px;
      padding: 8px 18px;
      font-size: 13px;
      font-weight: bold;
    }
    QPushButton#btnAdd:hover { background-color: #2D5016; }

    /* ── KPI Cards ── */
    QFrame#kpiCard {
      background-color: #FFFFFF;
      border: 1px solid #D6E8C4;
      border-radius: 12px;
    }
    QLabel#kpiLabel {
      color: #6A8F52;
      font-size: 10px;
      font-weight: bold;
      letter-spacing: 1px;
    }
    QLabel#kpiDeltaUp { color: #4A7C1F; font-size: 11px; }

    /* ── Table Card ── */
    QFrame#tableCard {
      background-color: #FFFFFF;
      border: 1px solid #D6E8C4;
      border-radius: 12px;
    }
    QLabel#cardTitle {
      color: #2D5016;
      font-size: 14px;
      font-weight: bold;
    }
    QTableWidget {
      background-color: #FFFFFF;
      border: none;
      gridline-color: #F2F6EE;
      font-size: 13px;
      color: #243D14;
    }
    QTableWidget::item { padding: 10px 12px; border-bottom: 1px solid #EEF5E6; }
    QTableWidget::item:selected { background-color: #DDEFC8; color: #2D5016; }
    QHeaderView::section {
      background-color: #F4F9EF;
      color: #6A8F52;
      font-size: 11px;
      font-weight: bold;
      padding: 10px 12px;
      border: none;
      border-bottom: 1px solid #D6E8C4;
    }

    /* ── Right Form Panel ── */
    QFrame#rightCard {
      background-color: #FFFFFF;
      border: 1px solid #D6E8C4;
      border-radius: 12px;
    }
    QFrame#rightCard QLabel {
      color: #4A6A32;
      font-size: 11px;
      font-weight: bold;
    }
    QFrame#rightCard QLineEdit {
      background-color: #F5F9F1;
      border: 1px solid #C8DFB0;
      border-radius: 6px;
      padding: 7px 10px;
      font-size: 12px;
      color: #243D14;
    }
    QFrame#rightCard QLineEdit:focus {
      border: 1px solid #4A7C1F;
      background-color: #FFFFFF;
    }
    QFrame#rightCard QLineEdit[readOnly="true"] {
      background-color: #EDF3E8;
      color: #88A870;
    }
    QPushButton#ajouterBtn {
      background-color: #4A7C1F;
      color: #FFFFFF;
      border: none;
      border-radius: 8px;
      padding: 9px 10px;
      font-size: 12px;
      font-weight: bold;
    }
    QPushButton#ajouterBtn:hover { background-color: #2D5016; }
    QPushButton#modifierBtn {
      background-color: #FFFFFF;
      color: #4A7C1F;
      border: 1px solid #B8D89A;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 12px;
    }
    QPushButton#modifierBtn:hover { background-color: #EEF7E4; }
    QPushButton#effacerBtn {
      background-color: #FFFFFF;
      color: #6A8F52;
      border: 1px solid #C8DFB0;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 12px;
    }
    QPushButton#effacerBtn:hover { background-color: #F2F6EE; }
    QPushButton#supprimerBtn {
      background-color: #FCEBEB;
      color: #A32D2D;
      border: 1px solid #F0C0C0;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 12px;
      font-weight: bold;
    }
    QPushButton#supprimerBtn:hover { background-color: #A32D2D; color: #FFFFFF; }
    QPushButton#historiqueBtn, QPushButton#statsFormBtn, QPushButton#statsSuperficieBtn, QPushButton#exportBtn {
      background-color: #FFFFFF;
      color: #4A7C1F;
      border: 1px solid #B8D89A;
      border-radius: 8px;
      padding: 7px 12px;
      font-size: 12px;
    }
    QPushButton#historiqueBtn:hover,
    QPushButton#statsFormBtn:hover, QPushButton#statsSuperficieBtn:hover, QPushButton#exportBtn:hover {
      background-color: #EEF7E4;
    }

    /* ── Attachment buttons ── */
    QPushButton#pieceJointeBtn {
      background-color: #EEF7E4;
      color: #2D5016;
      border: 1px solid #B8D89A;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 12px;
      font-weight: 600;
    }
    QPushButton#pieceJointeBtn:hover { background-color: #C8DFB0; }
    QPushButton#ouvrirFichierBtn {
      background-color: #FFFFFF;
      color: #4A7C1F;
      border: 1px solid #B8D89A;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 12px;
    }
    QPushButton#ouvrirFichierBtn:hover    { background-color: #EEF7E4; }
    QPushButton#ouvrirFichierBtn:disabled { color: #C0D4B0; border-color: #D6E8C4; }

    /* ── Scrollbars ── */
    QScrollBar:vertical {
      background: #EEF5E6; width: 6px; border-radius: 3px;
    }
    QScrollBar::handle:vertical { background: #A8D080; border-radius: 3px; }
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
    QScrollArea { border: none; background: transparent; }
   </string>
